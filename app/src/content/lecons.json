        { "locuteur": "Selin", "tr": "İyiyim, teşekkür ederim. Sen nasılsın?", "fr": "Je vais bien, merci. Et toi ?" },
        { "locuteur": "Karim", "tr": "Ben de iyiyim. Görüşürüz!", "fr": "Moi aussi. À bientôt !" },
        { "locuteur": "Selin", "tr": "Hoşça kal!", "fr": "Au revoir !" },
        { "locuteur": "Karim", "tr": "Güle güle!", "fr": "Au revoir !" }
