      "grammaire": [
        {
          "titre": "Tu ou vous : -sın / -sınız",
          "explication": "Comme en français, le turc distingue le tutoiement et le vouvoiement. « Nasılsın? » s'adresse à un ami ; « Nasılsınız? » s'adresse à une personne qu'on vouvoie ou à plusieurs personnes.",
          "exemples": [
            { "tr": "Merhaba Ali, nasılsın?", "fr": "Salut Ali, comment vas-tu ?" },
            { "tr": "Günaydın hocam, nasılsınız?", "fr": "Bonjour professeur, comment allez-vous ?" }
          ]
        },
        {
          "titre": "Hoşça kal / Güle güle",
          "explication": "La personne qui part dit « Hoşça kal » (ou « Hoşça kalın » au vouvoiement). La personne qui reste répond « Güle güle ».",
          "exemples": [
            { "tr": "— Hoşça kal! — Güle güle!", "fr": "— Au revoir ! (je pars) — Au revoir ! (je reste)" }
          ]
        }
      ],
