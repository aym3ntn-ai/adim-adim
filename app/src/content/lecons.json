      "grammaire": [
        {
          "titre": "Les 29 lettres",
          "explication": "L'alphabet turc utilise l'écriture latine : A B C Ç D E F G Ğ H I İ J K L M N O Ö P R S Ş T U Ü V Y Z. Il n'y a pas de Q, W ni X. Chaque lettre se prononce toujours de la même façon, et toutes les lettres se prononcent.",
          "exemples": []
        },
        {
          "titre": "Les lettres à retenir",
          "explication": "c se prononce « dj » ; ç se prononce « tch » ; ş se prononce « ch » ; ğ ne se prononce pas, il allonge la voyelle qui le précède ; ı (sans point) est un « i » prononcé sans étirer les lèvres, proche d'un « eu » bref ; i (avec point) est le « i » français ; ö se prononce « eu » ; ü est le « u » français ; u se prononce « ou » ; e est entre « é » et « è » ; g est toujours dur comme dans « gare » ; s est toujours « ss » ; h est aspiré ; r est roulé légèrement.",
          "exemples": [
            { "tr": "cami", "fr": "« djami » — mosquée" },
            { "tr": "çay", "fr": "« tchaï » — thé" },
            { "tr": "şeker", "fr": "« chéker » — sucre" },
            { "tr": "dağ", "fr": "« daa » — montagne" },
            { "tr": "gül", "fr": "« gul » — rose" },
            { "tr": "uzun", "fr": "« ouzoun » — long" }
          ]
        },
        {
          "titre": "Majuscules I / İ",
          "explication": "Attention : la majuscule de ı est I, et la majuscule de i est İ (avec point). Exemple : ılık → ILIK, İstanbul → İSTANBUL.",
          "exemples": [
            { "tr": "İstanbul", "fr": "Istanbul" },
            { "tr": "Işık", "fr": "lumière (prénom aussi)" }
          ]
        }
      ],
