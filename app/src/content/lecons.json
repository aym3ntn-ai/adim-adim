      "grammaire": [
        {
          "titre": "bu / şu / o",
          "explication": "bu = ceci (tout près), şu = cela (un peu plus loin, qu'on montre), o = cela là-bas (loin). Au pluriel : bunlar, şunlar, onlar.",
          "exemples": [
            { "tr": "Bu ne? — Bu bir kitap.", "fr": "Qu'est-ce que c'est ? — C'est un livre." },
            { "tr": "Şu ne? — Şu bir pencere.", "fr": "Qu'est-ce que c'est que ça ? — C'est une fenêtre." },
            { "tr": "Bunlar ne? — Bunlar kalem.", "fr": "Qu'est-ce que c'est ? — Ce sont des stylos." }
          ]
        },
        {
          "titre": "Ne ? / Kim ?",
          "explication": "« Ne? » s'utilise pour les choses, « Kim? » pour les personnes. « bir » sert d'article indéfini (un / une).",
          "exemples": [
            { "tr": "O kim? — O Ayşe.", "fr": "Qui est-ce ? — C'est Ayşe." },
            { "tr": "Bu bir çanta mı? — Evet, bu bir çanta.", "fr": "Est-ce un sac ? — Oui, c'est un sac." }
          ]
