    {
      "id": "L03",
      "numero": 3,
      "titre": "Se présenter",
      "titre_tr": "Kendimizi Tanıtalım",
      "objectifs": [
        "Dire son nom et demander celui des autres",
        "Connaître les pronoms personnels",
        "Comprendre l'harmonie vocalique",
        "Utiliser les suffixes du verbe « être »"
      ],
      "vocabulaire": [
        { "tr": "ad / isim", "fr": "nom, prénom" },
        { "tr": "soyadı", "fr": "nom de famille" },
        { "tr": "Benim adım …", "fr": "Je m'appelle …" },
        { "tr": "Adın ne?", "fr": "Comment t'appelles-tu ?" },
        { "tr": "Adınız ne?", "fr": "Comment vous appelez-vous ?" },
        { "tr": "Memnun oldum", "fr": "Enchanté(e)" },
        { "tr": "Ben de memnun oldum", "fr": "Moi de même, enchanté(e)" },
        { "tr": "öğrenci", "fr": "étudiant(e), élève" },
        { "tr": "öğretmen", "fr": "enseignant(e)" },
        { "tr": "doktor", "fr": "médecin" },
        { "tr": "mühendis", "fr": "ingénieur" },
        { "tr": "Ne iş yapıyorsun?", "fr": "Que fais-tu comme travail ?" }
      ],
      "grammaire": [
        {
          "titre": "Les pronoms personnels",
          "explication": "ben (je), sen (tu), o (il / elle — pas de genre en turc), biz (nous), siz (vous), onlar (ils / elles). Le pronom est souvent omis car la terminaison suffit.",
          "exemples": [
            { "tr": "O öğretmen.", "fr": "Il / Elle est enseignant(e)." }
          ]
        },
        {
          "titre": "L'harmonie vocalique",
          "explication": "Les suffixes changent de voyelle selon la dernière voyelle du mot. Harmonie à 2 formes (e/a) : après a, ı, o, u → a ; après e, i, ö, ü → e. Harmonie à 4 formes (ı/i/u/ü) : après a, ı → ı ; après e, i → i ; après o, u → u ; après ö, ü → ü.",
          "exemples": [
            { "tr": "kitap → kitaplar", "fr": "livre → livres (a → a)" },
            { "tr": "ev → evler", "fr": "maison → maisons (e → e)" },
            { "tr": "doktor → doktorum", "fr": "médecin → je suis médecin (o → u)" },
            { "tr": "Türk → Türküm", "fr": "Turc → je suis turc (ü → ü)" }
          ]
        },
        {
          "titre": "Le verbe « être » : suffixes personnels",
          "explication": "Il n'y a pas de verbe « être » séparé : on ajoute un suffixe au nom ou à l'adjectif. ben : -(y)ım/-(y)im/-(y)um/-(y)üm ; sen : -sın/-sin/-sun/-sün ; o : rien ; biz : -(y)ız/-(y)iz/-(y)uz/-(y)üz ; siz : -sınız/-siniz/-sunuz/-sünüz ; onlar : -lar/-ler (facultatif). Le « y » apparaît après une voyelle.",
          "exemples": [
            { "tr": "Ben öğrenciyim.", "fr": "Je suis étudiant(e)." },
            { "tr": "Sen öğrencisin.", "fr": "Tu es étudiant(e)." },
            { "tr": "O öğrenci.", "fr": "Il / Elle est étudiant(e)." },
            { "tr": "Biz öğrenciyiz.", "fr": "Nous sommes étudiants." },
            { "tr": "Siz öğrencisiniz.", "fr": "Vous êtes étudiant(s)." },
            { "tr": "Onlar öğrenci(ler).", "fr": "Ils sont étudiants." },
            { "tr": "Ben doktorum.", "fr": "Je suis médecin." }
          ]
        },
        {
          "titre": "La question : mı / mi / mu / mü",
          "explication": "Pour poser une question fermée, on ajoute la particule mı/mi/mu/mü (harmonie à 4 formes), écrite séparément. Le suffixe personnel s'attache à la particule.",
          "exemples": [
            { "tr": "Öğrenci misin?", "fr": "Es-tu étudiant(e) ?" },
            { "tr": "Doktor musunuz?", "fr": "Êtes-vous médecin ?" },
            { "tr": "Evet, doktorum. / Hayır, doktor değilim.", "fr": "Oui, je suis médecin. / Non, je ne suis pas médecin." }
          ]
        },
        {
          "titre": "La négation : değil",
          "explication": "Pour nier « être », on utilise « değil » suivi du suffixe personnel : değilim, değilsin, değil, değiliz, değilsiniz, değiller.",
          "exemples": [
            { "tr": "Ben öğretmen değilim.", "fr": "Je ne suis pas enseignant(e)." }
          ]
        }
      ],
      "dialogue": [
        { "locuteur": "Emre", "tr": "Merhaba, benim adım Emre. Senin adın ne?", "fr": "Bonjour, je m'appelle Emre. Et toi, comment t'appelles-tu ?" },
        { "locuteur": "Amel", "tr": "Merhaba Emre, benim adım Amel.", "fr": "Bonjour Emre, je m'appelle Amel." },
        { "locuteur": "Emre", "tr": "Memnun oldum Amel. Öğrenci misin?", "fr": "Enchanté, Amel. Tu es étudiante ?" },
        { "locuteur": "Amel", "tr": "Hayır, öğrenci değilim. Ben mühendisim. Sen?", "fr": "Non, je ne suis pas étudiante. Je suis ingénieure. Et toi ?" },
        { "locuteur": "Emre", "tr": "Ben öğretmenim.", "fr": "Je suis enseignant." }
      ],
      "exercices": [
        {
          "type": "completer",
          "consigne": "Complétez avec le bon suffixe : Ben mühendis…",
          "reponse": "Ben mühendisim."
        },
        {
          "type": "completer",
